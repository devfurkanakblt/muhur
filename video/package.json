{
  "name": "ekozeka-acilis-videosu",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EkoZekaAcilis out/ekozeka-acilis.mp4 --codec h264 --crf 16",
    "render:reels": "remotion render src/index.ts EkoZekaReels out/ekozeka-reels.mp4 --codec h264 --crf 16 --color-space bt709 && remotion still src/index.ts EkoZekaReels out/ekozeka-reels-kapak.png --frame 300",
    "stills": "node scripts/stills.mjs",
    "sfx": "python scripts/sfx.py public/sfx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "d3-geo": "^3.1.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.529",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9.3"
  }
}
